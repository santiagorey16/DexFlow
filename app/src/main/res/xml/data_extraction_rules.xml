<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de copia y transferencia (Android 12+).
   Las claves de IA y el token de GitHub (devflow_secure.xml) nunca salen del teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="devflow_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="devflow_secure.xml" />
    </device-transfer>
</data-extraction-rules>
