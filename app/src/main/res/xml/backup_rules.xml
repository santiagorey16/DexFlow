<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de copia de seguridad (Android 11 o anterior).
   Las claves de IA y el token de GitHub (devflow_secure.xml) nunca se respaldan:
   están cifradas con una llave del Keystore que solo existe en este teléfono.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="devflow_secure.xml" />
</full-backup-content>
